<%- include('../partials/header') %>
<h1><%= book.title %></h1>
<dl>
  <dt>Author</dt><dd><%= book.author %></dd>
  <dt>Genre</dt><dd><%= book.genre || '-' %></dd>
  <dt>Price</dt><dd>$<%= Number(book.price).toFixed(2) %></dd>
  <dt>In stock</dt><dd><%= book.stock %></dd>
</dl>
<p>
  <a class="btn" href="/books/<%= book.id %>/edit">Edit</a>
  <a href="/books">Back to books</a>
</p>
<%- include('../partials/footer') %>
