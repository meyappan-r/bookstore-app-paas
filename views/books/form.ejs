<%- include('../partials/header') %>
<h1><%= heading %></h1>
<% errors.forEach(e => { %><p class="error"><%= e %></p><% }) %>
<form method="post" action="<%= action %>">
  <label>Title <input name="title" value="<%= book.title || '' %>" required></label>
  <label>Author <input name="author" value="<%= book.author || '' %>" required></label>
  <label>Genre <input name="genre" value="<%= book.genre || '' %>"></label>
  <label>Price ($) <input name="price" type="number" step="0.01" min="0" value="<%= book.price ?? '' %>" required></label>
  <label>Stock <input name="stock" type="number" step="1" min="0" value="<%= book.stock ?? '' %>" required></label>
  <p><button class="btn">Save</button> <a href="/books">Cancel</a></p>
</form>
<%- include('../partials/footer') %>
