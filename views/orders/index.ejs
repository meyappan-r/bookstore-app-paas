<%- include('../partials/header') %>
<h1>Customer Orders</h1>
<p><a class="btn" href="/orders/new">+ New order</a></p>
<% if (!orders.length) { %>
  <p>No orders yet.</p>
<% } else { %>
<table>
  <thead><tr><th>Date</th><th>Customer</th><th>Book</th><th>Qty</th><th>Total</th><th>Status</th><th>Actions</th></tr></thead>
  <tbody>
  <% orders.forEach(o => { %>
    <tr>
      <td><%= o.createdAt.slice(0, 10) %></td>
      <td><%= o.customerName %><br><small><%= o.customerEmail %></small></td>
      <td><%= o.bookTitle %></td>
      <td><%= o.quantity %></td>
      <td>$<%= Number(o.total).toFixed(2) %></td>
      <td><span class="status <%= o.status.toLowerCase() %>"><%= o.status %></span></td>
      <td class="actions">
        <a href="/orders/<%= o.id %>/edit">Edit</a>
        <form method="post" action="/orders/<%= o.id %>/delete" onsubmit="return confirm('Delete this order?')">
          <button class="link danger">Delete</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } %>
<%- include('../partials/footer') %>
